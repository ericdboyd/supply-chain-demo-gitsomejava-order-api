# Keep host build output out of the image build context.
#
# Without this, a local `dotnet build` leaves obj/project.assets.json full of
# Windows paths, the container restore collides with it, and the build fails
# with a confusing MSB4018. Costs ten minutes to diagnose on a stage.

bin/
obj/
*.user
*.suo
.vs/
.vscode/

# Never let a local secrets file reach an image layer.
.env
*.env
appsettings.*.Local.json
